    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n\n  const score = Number(item.json.score);\n  const category = String(item.json.category).trim().toUpperCase();\n\n  let valid = false;\n\n  if (score >= 0 && score <= 49 && category === \"COLD\") {\n    valid = true;\n  }\n\n  else if (score >= 50 && score <= 79 && category === \"WARM\") {\n    valid = true;\n  }\n\n  else if (score >= 80 && score <= 100 && category === \"HOT\") {\n    valid = true;\n  }\n\n  item.json.aiValidation = valid ? \"VALID\" : \"INVALID\";\n}\n\nreturn $input.all();"
      },
